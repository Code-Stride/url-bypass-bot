# Telegram token from @BotFather (omit to run website-only)
BOT_TOKEN=123456789:AAExampleExampleExampleExample

# Optional
# ENABLE_BOT=0            # website only
# USE_BROWSER=1           # 0 disables the browser engine (much less accurate)
# BROWSER_CONCURRENCY=2   # parallel browser resolutions (~250MB RAM each)
# RESOLVE_TIMEOUT=180     # total budget per link, seconds
# BROWSER_TIMEOUT=150     # browser budget per link, seconds
